# scripts/generate_report.py 로컬 테스트용. 실제 값은 .env에 채우고 커밋하지 마세요.
# GitHub Actions에서는 이 값들을 Settings > Secrets and variables > Actions 에 등록합니다.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
FINNHUB_API_KEY=your-finnhub-api-key
REPORT_BASE_URL=https://your-github-username.github.io/your-repo/docs

# 아래 3개는 선택 사항입니다 — 채워두면 이메일도 발송되고, 비워두면 DB 저장만 하고 끝납니다.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# RECIPIENT_EMAIL=you@gmail.com
